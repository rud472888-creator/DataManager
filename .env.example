# Footage Data Manager example environment
FDM_HOST=127.0.0.1
FDM_PORT=8000
FDM_TOKEN=change-me
FDM_DATA_DIR=.fdm_data
FDM_DEV_SOURCE_ROOT=.fdm_fixtures/source
FDM_ALLOWED_DEST_ROOTS=.fdm_dest
FDM_LOG_LEVEL=INFO
# Optional: command that prints adapter-backed BRAW metadata as a JSON object.
# Contract: <command> <file_path>
FDM_BRAW_METADATA_COMMAND=
# Optional: command that captures JPEG stills and prints a JSON array of frame paths.
# Contract: <command> <file_path> <output_dir> <indices_csv>
FDM_BRAW_FRAME_CAPTURE_COMMAND=
